# Optional LLM pass (OpenAI-compatible Chat Completions endpoint). Leave empty for rule-based only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional Jira connector. Leave empty to keep it off. Never commit a token.
# Cloud: set JIRA_EMAIL. Server/Data Center: set JIRA_DEPLOYMENT=server and omit the email.
# JIRA_BASE_URL=https://example.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# JIRA_DEPLOYMENT=auto
# JIRA_ISSUE_TYPE=Requirement
# JIRA_STATUS_MAP={"Done":"Passed","In Progress":"In progress"}

# HOST=127.0.0.1
# PORT=8000
